# Development defaults (committed, no secrets). Overridden by .env.development.local / .env.local.
# Mock providers let the translator and practice flows run without a backend. Never used in production builds.
VITE_TRANSLATION_PROVIDER=mock
VITE_AI_PROVIDER=mock
VITE_STT_PROVIDER=browser
VITE_TTS_PROVIDER=browser
VITE_WEATHER_PROVIDER=open-meteo
