# Erasmus Help — environment variables
# Copy to .env.local and adjust. Every VITE_* value is PUBLIC (bundled into the browser).
# Never put API keys or secrets in VITE_* variables. Private keys belong to the backend /
# Supabase Edge Functions reached through VITE_API_BASE_URL.

# Base URL of the backend that proxies private APIs (translation, AI). HTTPS only (localhost allowed).
# Endpoints expected: POST /translate, POST /correct, POST /practice
VITE_API_BASE_URL=

# Translation provider: http (uses VITE_API_BASE_URL) | mock (development only) | none
VITE_TRANSLATION_PROVIDER=none

# AI provider (correction + practice conversation): http | mock | none
VITE_AI_PROVIDER=none

# Speech-to-text: browser (Web Speech API) | mock | none
VITE_STT_PROVIDER=browser

# Text-to-speech: browser (speechSynthesis) | none
VITE_TTS_PROVIDER=browser

# Weather: open-meteo (free, no key) | none
VITE_WEATHER_PROVIDER=open-meteo

# Web Push public VAPID key (public by design). Leave empty until push is configured.
VITE_VAPID_PUBLIC_KEY=

# Supabase (Chat: auth, database, realtime, audio storage). The publishable key is public by design;
# RLS protects the data. NEVER use the service_role / sb_secret_ key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
